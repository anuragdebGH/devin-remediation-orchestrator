# GitHub webhook validation and API access
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-value
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPOSITORY=anuragdebGH/superset
TRIGGER_LABEL=devin-remediate

# Current Devin v3 API credentials
DEVIN_API_KEY=cog_replace_me
DEVIN_ORG_ID=org-replace-me
DEVIN_API_BASE_URL=https://api.devin.ai
DEVIN_MODE=normal
DEVIN_MAX_ACU_LIMIT=10

# Runtime controls
DATABASE_PATH=/data/orchestrator.db
POLL_INTERVAL_SECONDS=15
MAX_CONCURRENT_SESSIONS=3
TRUSTED_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
LOG_LEVEL=INFO

# Set both to mock for the credential-free simulation only.
DEVIN_CLIENT_MODE=live
GITHUB_CLIENT_MODE=live
ENABLE_DEMO_ENDPOINT=false
